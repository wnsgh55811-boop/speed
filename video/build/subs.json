[
 {
  "t": 0.16,
  "d": 5.084,
  "text": "소개팅 첫 1분만에 여자에게 감점되는 남자들이 있습니다"
 },
 {
  "t": 5.744,
  "d": 2.674,
  "text": "대화를 못해서가 아닙니다"
 },
 {
  "t": 8.918,
  "d": 7.763,
  "text": "오히려 잘 보이고 싶은 마음이 너무 커져서 평소에는 하지 않던 행동들이 나오기 때문입니다"
 },
 {
  "t": 17.181,
  "d": 2.316,
  "text": "예를 한번 들어볼게요"
 },
 {
  "t": 19.997,
  "d": 2.852,
  "text": "소개팅 장소에 도착했습니다"
 },
 {
  "t": 23.349,
  "d": 1.915,
  "text": "상대가 들어와요"
 },
 {
  "t": 25.764,
  "d": 2.897,
  "text": "사진보다 훨씬 마음에 듭니다"
 },
 {
  "t": 29.161,
  "d": 3.656,
  "text": "그 순간부터 갑자기 머리가 바빠집니다"
 },
 {
  "t": 33.317,
  "d": 1.629,
  "text": "잘 보여야 되는데."
 },
 {
  "t": 34.946,
  "d": 1.833,
  "text": "재밌게 해야 되는데."
 },
 {
  "t": 36.78,
  "d": 2.291,
  "text": "첫인상 망치면 안 되는데."
 },
 {
  "t": 39.571,
  "d": 1.939,
  "text": "그리고 인사를 합니다"
 },
 {
  "t": 41.51,
  "d": 1.123,
  "text": "안녕하세요."
 },
 {
  "t": 42.633,
  "d": 2.603,
  "text": "여기까지는 아무 문제 없어요"
 },
 {
  "t": 45.736,
  "d": 4.191,
  "text": "근데 그다음부터 조금씩 달라지기 시작합니다"
 },
 {
  "t": 50.427,
  "d": 1.924,
  "text": "오는 길 괜찮으셨어요?"
 },
 {
  "t": 52.351,
  "d": 2.549,
  "text": "여기 찾기 어렵진 않으셨어요?"
 },
 {
  "t": 54.9,
  "d": 1.106,
  "text": "뭐 드실래요?"
 },
 {
  "t": 56.006,
  "d": 2.116,
  "text": "저는 아무거나 괜찮아요."
 },
 {
  "t": 58.123,
  "d": 1.732,
  "text": "편하신 걸로 드세요."
 },
 {
  "t": 59.854,
  "d": 2.309,
  "text": "사진보다 훨씬 예쁘시네요."
 },
 {
  "t": 62.663,
  "d": 3.853,
  "text": "각각의 말을 하나씩 보면 이상한 건 없습니다"
 },
 {
  "t": 66.516,
  "d": 1.433,
  "text": "오히려 친절해요"
 },
 {
  "t": 67.949,
  "d": 2.075,
  "text": "상대도 배려하고 있고요"
 },
 {
  "t": 70.524,
  "d": 6.468,
  "text": "근데 중요한 건 무슨 말을 했느냐보다 그 말을 하고 있는 사람의 상태입니다"
 },
 {
  "t": 77.492,
  "d": 7.004,
  "text": "상대가 너무 마음에 드는 순간부터 남자가 계속 여자 반응을 확인하고 있는 거예요"
 },
 {
  "t": 84.996,
  "d": 1.712,
  "text": "내가 웃기면 웃는지"
 },
 {
  "t": 86.708,
  "d": 2.115,
  "text": "표정이 굳지는 않았는지"
 },
 {
  "t": 88.824,
  "d": 2.417,
  "text": "내가 마음에 드는 것 같은지"
 },
 {
  "t": 91.741,
  "d": 5.441,
  "text": "그래서 자기 생각보다 상대가 좋아할 만한 답을 먼저 찾습니다"
 },
 {
  "t": 97.682,
  "d": 4.772,
  "text": "우리가 첫인상이라고 하면 보통 외모부터 생각합니다"
 },
 {
  "t": 102.954,
  "d": 1.547,
  "text": "옷을 잘 입었는지"
 },
 {
  "t": 104.501,
  "d": 1.495,
  "text": "머리가 괜찮은지"
 },
 {
  "t": 105.996,
  "d": 1.083,
  "text": "키가 어떤지"
 },
 {
  "t": 107.079,
  "d": 1.495,
  "text": "목소리가 어떤지"
 },
 {
  "t": 109.074,
  "d": 2.897,
  "text": "물론 다 첫인상에 들어갑니다"
 },
 {
  "t": 112.471,
  "d": 4.861,
  "text": "근데 실제로 사람을 만나면 그것만 보고 있지는 않아요"
 },
 {
  "t": 117.832,
  "d": 3.08,
  "text": "이 사람이 말을 얼마나 급하게 하는지"
 },
 {
  "t": 120.912,
  "d": 2.843,
  "text": "내가 말할 때 얼마나 기다려주는지"
 },
 {
  "t": 123.756,
  "d": 1.611,
  "text": "자기 의견이 있는지"
 },
 {
  "t": 125.367,
  "d": 3.222,
  "text": "조금 어색해졌을 때 어떻게 반응하는지"
 },
 {
  "t": 128.589,
  "d": 3.033,
  "text": "실수했을 때 얼마나 크게 흔들리는지"
 },
 {
  "t": 132.122,
  "d": 2.897,
  "text": "이런 것들도 같이 인식됩니다"
 },
 {
  "t": 135.519,
  "d": 5.754,
  "text": "그래서 저는 첫인상을 단순히 외모의 문제라고 생각하지 않습니다"
 },
 {
  "t": 141.773,
  "d": 3.17,
  "text": "오히려 이런 질문에 더 가깝다고 봐요"
 },
 {
  "t": 150.125,
  "d": 2.495,
  "text": "이걸 한번 생각해보세요"
 },
 {
  "t": 153.12,
  "d": 6.825,
  "text": "별로 마음에 들지 않는 소개팅 상대를 만났을 때는 오히려 편한 경우가 있습니다"
 },
 {
  "t": 160.445,
  "d": 3.075,
  "text": "카페에 들어와서 메뉴를 봅니다"
 },
 {
  "t": 164.02,
  "d": 3.483,
  "text": "저는 아메리카노 마실게요. 뭐 드실래요?"
 },
 {
  "t": 167.503,
  "d": 1.79,
  "text": "그냥 자연스럽습니다"
 },
 {
  "t": 169.293,
  "d": 3.918,
  "text": "상대가 자기 의견이랑 달라도 별생각 없습니다"
 },
 {
  "t": 173.711,
  "d": 3.7,
  "text": "저는 여행할 때 계획 안 짜는 게 좋아요."
 },
 {
  "t": 177.911,
  "d": 0.605,
  "text": "그러면"
 },
 {
  "t": 178.516,
  "d": 4.133,
  "text": "진짜요? 저는 계획 엄청 짜는데 완전 반대네요."
 },
 {
  "t": 182.649,
  "d": 1.462,
  "text": "하고 넘어갑니다"
 },
 {
  "t": 184.611,
  "d": 4.861,
  "text": "근데 정말 마음에 드는 사람을 만나면 상황이 바뀝니다"
 },
 {
  "t": 189.972,
  "d": 1.47,
  "text": "여자가 말합니다"
 },
 {
  "t": 191.442,
  "d": 4.105,
  "text": "저는 여행할 때 계획 많이 짜는 사람이 좋아요."
 },
 {
  "t": 196.047,
  "d": 3.477,
  "text": "남자는 사실 즉흥 여행을 좋아합니다"
 },
 {
  "t": 200.024,
  "d": 2.532,
  "text": "근데 바로 이런 생각이 들어요"
 },
 {
  "t": 202.556,
  "d": 5.454,
  "text": "나는 계획 잘 안 짜는데 이거 말하면 안 맞는 사람처럼 보이려나?"
 },
 {
  "t": 208.51,
  "d": 0.64,
  "text": "그래서"
 },
 {
  "t": 209.15,
  "d": 2.398,
  "text": "저도 계획 짜는 편이에요."
 },
 {
  "t": 211.548,
  "d": 1.332,
  "text": "라고 말합니다"
 },
 {
  "t": 213.38,
  "d": 4.325,
  "text": "이런 작은 일이 한 번이면 아무 문제가 없습니다"
 },
 {
  "t": 218.205,
  "d": 4.236,
  "text": "근데 이게 계속 반복되면 사람이 흐릿해집니다"
 },
 {
  "t": 222.941,
  "d": 4.056,
  "text": "여자가 뭘 좋아한다고 하면 나도 좋아한다고 하고"
 },
 {
  "t": 226.997,
  "d": 3.018,
  "text": "싫어한다고 하면 나도 별로라고 하고"
 },
 {
  "t": 230.016,
  "d": 3.443,
  "text": "장소를 물어보면 아무 데나 괜찮다고 하고"
 },
 {
  "t": 233.459,
  "d": 3.584,
  "text": "메뉴를 물어봐도 아무거나 괜찮다고 합니다"
 },
 {
  "t": 237.543,
  "d": 2.105,
  "text": "상대는 편할 수 있습니다"
 },
 {
  "t": 239.648,
  "d": 5.435,
  "text": "근데 한편으로는 이 사람이 어떤 사람인지 알기가 어려워집니다"
 },
 {
  "t": 245.583,
  "d": 4.861,
  "text": "저는 여기서 굉장히 중요한 차이가 하나 있다고 봅니다"
 },
 {
  "t": 250.944,
  "d": 7.004,
  "text": "첫 만남에서 좋은 사람으로 보이는 것과 나라는 사람이 보이는 건 다른 문제입니다"
 },
 {
  "t": 258.448,
  "d": 6.038,
  "text": "좋은 사람으로 보이려고만 하면 실수를 줄이는 방향으로 움직이게 됩니다"
 },
 {
  "t": 264.486,
  "d": 2.217,
  "text": "상대가 싫어할 말을 피하고"
 },
 {
  "t": 266.703,
  "d": 1.604,
  "text": "의견 충돌을 피하고"
 },
 {
  "t": 268.307,
  "d": 4.198,
  "text": "조금이라도 이상한 반응이 나오면 바로 수습합니다"
 },
 {
  "t": 273.005,
  "d": 4.129,
  "text": "근데 나라는 사람이 보이려면 반대로 해야 합니다"
 },
 {
  "t": 277.134,
  "d": 1.872,
  "text": "내 취향도 나와야 하고"
 },
 {
  "t": 279.006,
  "d": 1.872,
  "text": "내 생각도 나와야 하고"
 },
 {
  "t": 280.878,
  "d": 2.881,
  "text": "상대와 다른 부분도 나와야 합니다"
 },
 {
  "t": 284.259,
  "d": 2.888,
  "text": "그래야 상대도 판단할 수 있습니다"
 },
 {
  "t": 287.147,
  "d": 2.358,
  "text": "이 사람은 이런 사람이구나."
 },
 {
  "t": 289.505,
  "d": 1.829,
  "text": "이런 건 나랑 잘 맞네."
 },
 {
  "t": 291.334,
  "d": 1.781,
  "text": "이건 나랑 좀 다르네."
 },
 {
  "t": 293.115,
  "d": 2.166,
  "text": "근데 이런 부분은 괜찮다."
 },
 {
  "t": 295.781,
  "d": 3.254,
  "text": "이게 사람을 알아가는 과정입니다"
 },
 {
  "t": 299.535,
  "d": 5.801,
  "text": "그런데 소개팅에서 자꾸 실패하는 남자들은 상대에게 판단할 재료를 주는 것보다 좋은 평가를"
 },
 {
  "t": 305.336,
  "d": 5.801,
  "text": "받는 걸 더 중요하게 생각하는 경우가 많습니다"
 },
 {
  "t": 311.637,
  "d": 3.681,
  "text": "그러다 보니까 관계의 구조가 이상해집니다"
 },
 {
  "t": 315.318,
  "d": 1.84,
  "text": "상대는 평가하는 사람"
 },
 {
  "t": 317.158,
  "d": 1.647,
  "text": "나는 평가받는 사람"
 },
 {
  "t": 318.805,
  "d": 2.47,
  "text": "이렇게 기울어지게 되는 거죠"
 },
 {
  "t": 321.775,
  "d": 6.2,
  "text": "마음에 드는 사람이 앞에 있다는 이유만으로 내가 지원자가 되는 거예요"
 },
 {
  "t": 328.475,
  "d": 2.214,
  "text": "그러면 당연히 긴장합니다"
 },
 {
  "t": 330.689,
  "d": 1.925,
  "text": "실수하면 안 될 것 같고"
 },
 {
  "t": 332.615,
  "d": 2.118,
  "text": "정답을 말해야 할 것 같고"
 },
 {
  "t": 334.732,
  "d": 4.14,
  "text": "상대가 좋아하는 모습을 보여줘야 할 것 같습니다"
 },
 {
  "t": 339.372,
  "d": 2.674,
  "text": "이 구조 자체를 바꿔야 합니다"
 },
 {
  "t": 342.046,
  "d": 2.366,
  "text": "소개팅은 면접이 아닙니다"
 },
 {
  "t": 344.912,
  "d": 2.802,
  "text": "여러분도 상대를 평가해야 합니다"
 },
 {
  "t": 347.714,
  "d": 2.469,
  "text": "나랑 대화가 잘 맞는 사람인지"
 },
 {
  "t": 350.183,
  "d": 2.849,
  "text": "내가 실제로 좋아할 만한 사람인지"
 },
 {
  "t": 353.032,
  "d": 2.422,
  "text": "사람을 대하는 태도가 어떤지"
 },
 {
  "t": 355.453,
  "d": 2.802,
  "text": "연애를 바라보는 기준이 비슷한지"
 },
 {
  "t": 358.755,
  "d": 2.549,
  "text": "이런 것들을 서로 보는 겁니다"
 },
 {
  "t": 361.304,
  "d": 4.901,
  "text": "이 감각이 있으면 첫 만남에서 굉장히 많은 게 달라집니다"
 },
 {
  "t": 366.705,
  "d": 2.718,
  "text": "예를 들어 메뉴를 고릅니다"
 },
 {
  "t": 369.923,
  "d": 1.665,
  "text": "여자가 묻습니다"
 },
 {
  "t": 371.588,
  "d": 1.321,
  "text": "뭐 드실래요?"
 },
 {
  "t": 373.409,
  "d": 0.767,
  "text": "예전에는"
 },
 {
  "t": 374.176,
  "d": 4.315,
  "text": "저는 아무거나 괜찮아요. 드시고 싶은 걸로 하세요."
 },
 {
  "t": 378.492,
  "d": 1.007,
  "text": "라고 했다면"
 },
 {
  "t": 379.499,
  "d": 0.575,
  "text": "이제는"
 },
 {
  "t": 380.074,
  "d": 4.124,
  "text": "저는 커피 마실 건데 혹시 드시고 싶은 거 있어요?"
 },
 {
  "t": 384.198,
  "d": 1.438,
  "text": "라고 하면 됩니다"
 },
 {
  "t": 386.136,
  "d": 3.7,
  "text": "내 선택도 있고 상대의 선택도 있습니다"
 },
 {
  "t": 390.336,
  "d": 1.514,
  "text": "여자가 말합니다"
 },
 {
  "t": 391.85,
  "d": 3.079,
  "text": "저는 사람 많은 곳 진짜 싫어해요."
 },
 {
  "t": 395.429,
  "d": 2.712,
  "text": "내가 사람 많은 곳을 좋아한다면"
 },
 {
  "t": 398.141,
  "d": 4.892,
  "text": "저는 오히려 조금 북적거리는 데가 좋던데 완전 반대네요."
 },
 {
  "t": 403.033,
  "d": 1.453,
  "text": "라고 하면 됩니다"
 },
 {
  "t": 406.964,
  "d": 1.187,
  "text": "전혀 아니죠"
 },
 {
  "t": 408.651,
  "d": 2.31,
  "text": "오히려 대화할 게 생깁니다"
 },
 {
  "t": 410.961,
  "d": 2.016,
  "text": "왜 그런 데 좋아하세요?"
 },
 {
  "t": 412.977,
  "d": 3.392,
  "text": "저는 조용하면 오히려 어색하더라고요."
 },
 {
  "t": 416.869,
  "d": 2.897,
  "text": "이제 둘이 서로를 알아갑니다"
 },
 {
  "t": 420.266,
  "d": 5.052,
  "text": "그런데 많은 남자들은 이런 차이가 생기는 걸 두려워합니다"
 },
 {
  "t": 425.318,
  "d": 2.354,
  "text": "다르면 안 맞는 것 같거든요"
 },
 {
  "t": 428.172,
  "d": 5.209,
  "text": "근데 관계에서 중요한 건 모든 게 같은 사람이 되는 게 아닙니다"
 },
 {
  "t": 433.381,
  "d": 6.393,
  "text": "서로 다른 두 사람이 그 차이를 편하게 이야기할 수 있느냐가 훨씬 중요합니다"
 },
 {
  "t": 440.274,
  "d": 5.208,
  "text": "그리고 첫 만남에서 또 하나 굉장히 많이 나오는 게 있습니다"
 },
 {
  "t": 445.482,
  "d": 1.439,
  "text": "과한 해명입니다"
 },
 {
  "t": 447.421,
  "d": 1.933,
  "text": "말이 한번 꼬였습니다"
 },
 {
  "t": 449.354,
  "d": 0.407,
  "text": "그냥"
 },
 {
  "t": 449.761,
  "d": 1.425,
  "text": "아 말 꼬였네요."
 },
 {
  "t": 451.186,
  "d": 2.391,
  "text": "하고 웃으면 끝날 일입니다"
 },
 {
  "t": 454.077,
  "d": 3.142,
  "text": "근데 불안한 사람은 바로 설명합니다"
 },
 {
  "t": 457.219,
  "d": 4.174,
  "text": "제가 원래 말은 잘하는데 오늘 좀 긴장했나 봐요."
 },
 {
  "t": 461.893,
  "d": 2.631,
  "text": "여자가 잠깐 표정이 굳었습니다"
 },
 {
  "t": 464.524,
  "d": 1.387,
  "text": "바로 덧붙입니다"
 },
 {
  "t": 465.911,
  "d": 3.253,
  "text": "아 물론 그런 뜻으로 말한 건 아니고요."
 },
 {
  "t": 469.164,
  "d": 1.913,
  "text": "사람마다 다르긴 하죠."
 },
 {
  "t": 471.078,
  "d": 2.774,
  "text": "제가 표현을 좀 이상하게 했네요."
 },
 {
  "t": 474.352,
  "d": 6.022,
  "text": "상대는 별생각 없었는데 본인이 상황을 더 크게 만드는 경우가 있어요"
 },
 {
  "t": 483.021,
  "d": 7.54,
  "text": "실수 자체가 두려운 게 아니라 그 실수 때문에 상대가 나를 안 좋게 볼까 봐 두려운 겁니다"
 },
 {
  "t": 491.061,
  "d": 4.236,
  "text": "그래서 계속 자기 이미지를 복구하려고 합니다"
 },
 {
  "t": 495.797,
  "d": 4.529,
  "text": "근데 아이러니하게도 실제 실수보다 그걸 급하게 수습하려는 태도에서 불안함이 더 크게 보일"
 },
 {
  "t": 500.326,
  "d": 4.529,
  "text": "때가 있습니다"
 },
 {
  "t": 505.354,
  "d": 5.933,
  "text": "여기서 제가 이전 영상에서 이야기했던 공백의 태도와도 연결됩니다"
 },
 {
  "t": 511.787,
  "d": 2.238,
  "text": "침묵이 생기면 질문합니다"
 },
 {
  "t": 514.025,
  "d": 1.8,
  "text": "실수하면 해명합니다"
 },
 {
  "t": 515.825,
  "d": 2.871,
  "text": "상대 표정이 애매하면 수습합니다"
 },
 {
  "t": 518.696,
  "d": 2.238,
  "text": "의견이 다르면 수정합니다"
 },
 {
  "t": 521.434,
  "d": 4.683,
  "text": "아무것도 하지 않아도 되는 순간을 못 견디는 겁니다"
 },
 {
  "t": 526.617,
  "d": 5.754,
  "text": "소개팅 첫 1분에서 중요한 건 멋있는 첫마디를 외우는 게 아닙니다"
 },
 {
  "t": 532.871,
  "d": 3.879,
  "text": "저는 오히려 세 가지를 봤으면 좋겠습니다"
 },
 {
  "t": 537.25,
  "d": 0.66,
  "text": "첫 번째"
 },
 {
  "t": 537.91,
  "d": 4.826,
  "text": "상대가 마음에 든다고 해서 나를 낮추려고 하지 마세요"
 },
 {
  "t": 543.236,
  "d": 5.057,
  "text": "상대가 예쁘고 매력적이라고 느끼는 건 아무 문제가 없습니다"
 },
 {
  "t": 548.293,
  "d": 6.947,
  "text": "근데 상대가 매력적이라는 사실과 내가 더 낮은 사람이라는 건 전혀 다른 얘기입니다"
 },
 {
  "t": 558.529,
  "d": 3.635,
  "text": "그걸로 내 말투까지 바꿀 필요는 없습니다"
 },
 {
  "t": 562.664,
  "d": 0.676,
  "text": "두 번째"
 },
 {
  "t": 563.34,
  "d": 4.007,
  "text": "첫 만남부터 자기 자신을 조금씩 보여주세요"
 },
 {
  "t": 567.847,
  "d": 3.254,
  "text": "거창한 자기소개를 하라는 게 아닙니다"
 },
 {
  "t": 571.101,
  "d": 2.536,
  "text": "저는 책임감 있는 남자입니다."
 },
 {
  "t": 573.637,
  "d": 2.919,
  "text": "저는 여자친구한테 정말 잘합니다."
 },
 {
  "t": 576.556,
  "d": 2.536,
  "text": "이런 말을 굳이 할 필요 없어요"
 },
 {
  "t": 579.592,
  "d": 2.193,
  "text": "작은 취향이면 충분합니다"
 },
 {
  "t": 581.785,
  "d": 1.716,
  "text": "저는 이건 좋아해요."
 },
 {
  "t": 583.501,
  "d": 1.954,
  "text": "저는 그건 좀 별로예요."
 },
 {
  "t": 585.455,
  "d": 2.955,
  "text": "저는 여행할 때 이런 스타일이에요."
 },
 {
  "t": 588.41,
  "d": 3.766,
  "text": "저는 주말에는 이렇게 보내는 게 좋더라고요."
 },
 {
  "t": 592.676,
  "d": 4.058,
  "text": "이런 작은 정보가 쌓이면서 사람이 보입니다"
 },
 {
  "t": 597.234,
  "d": 0.682,
  "text": "세 번째"
 },
 {
  "t": 597.916,
  "d": 3.777,
  "text": "상대의 반응보다 조금 느리게 움직이세요"
 },
 {
  "t": 602.193,
  "d": 2.378,
  "text": "여자가 잠깐 조용해졌습니다"
 },
 {
  "t": 604.571,
  "d": 2.236,
  "text": "바로 질문할 필요 없습니다"
 },
 {
  "t": 606.807,
  "d": 2.616,
  "text": "상대 표정이 살짝 바뀌었습니다"
 },
 {
  "t": 609.424,
  "d": 2.426,
  "text": "바로 수습하지 않아도 됩니다"
 },
 {
  "t": 611.85,
  "d": 1.617,
  "text": "내 의견과 다릅니다"
 },
 {
  "t": 613.467,
  "d": 2.426,
  "text": "바로 철회하지 않아도 됩니다"
 },
 {
  "t": 616.393,
  "d": 1.279,
  "text": "한 번 들어보고"
 },
 {
  "t": 617.672,
  "d": 1.279,
  "text": "한 번 생각하고"
 },
 {
  "t": 618.951,
  "d": 2.066,
  "text": "그다음 반응하면 됩니다"
 },
 {
  "t": 621.017,
  "d": 3.541,
  "text": "저는 이게 굉장히 중요하다고 생각합니다"
 },
 {
  "t": 625.058,
  "d": 5.397,
  "text": "선택받으려고 애쓰는 것과 서로 선택하는 건 완전히 다릅니다"
 },
 {
  "t": 630.955,
  "d": 5.887,
  "text": "선택받으려고 할 때는 상대 반응 하나하나가 시험 결과처럼 느껴집니다"
 },
 {
  "t": 636.842,
  "d": 5.269,
  "text": "서로 선택한다고 생각하면 상대의 반응도 하나의 정보가 됩니다"
 },
 {
  "t": 642.611,
  "d": 4.936,
  "text": "여러분이 어떤 말을 했는데 상대가 별로 좋아하지 않습니다"
 },
 {
  "t": 647.547,
  "d": 0.575,
  "text": "그러면"
 },
 {
  "t": 648.122,
  "d": 3.69,
  "text": "아 이 사람은 이런 걸 별로 안 좋아하는구나."
 },
 {
  "t": 651.812,
  "d": 1.821,
  "text": "라고 생각하면 됩니다"
 },
 {
  "t": 654.133,
  "d": 0.43,
  "text": "굳이"
 },
 {
  "t": 654.563,
  "d": 1.451,
  "text": "내가 잘못했나?"
 },
 {
  "t": 656.014,
  "d": 2.31,
  "text": "까지 갈 필요는 없습니다"
 },
 {
  "t": 658.824,
  "d": 6.689,
  "text": "반대로 상대가 하는 이야기가 여러분이 별로 좋아하지 않는 방식일 수도 있습니다"
 },
 {
  "t": 665.513,
  "d": 1.554,
  "text": "그것도 정보입니다"
 },
 {
  "t": 667.067,
  "d": 5.323,
  "text": "이런 정보를 통해서 상대가 나와 잘 맞는 사람인지 판단하는 거죠"
 },
 {
  "t": 672.89,
  "d": 6.379,
  "text": "저는 결국 첫인상에서 가장 먼저 전달되는 게 이런 부분이라고 생각합니다"
 },
 {
  "t": 679.769,
  "d": 4.166,
  "text": "여러분이 얼마나 멋있는 사람인지 설명하는 것보다"
 },
 {
  "t": 683.935,
  "d": 4.307,
  "text": "마음에 드는 사람 앞에서도 내가 나로 있을 수 있는지"
 },
 {
  "t": 688.242,
  "d": 2.856,
  "text": "조금 어색한 순간을 견딜 수 있는지"
 },
 {
  "t": 691.098,
  "d": 3.464,
  "text": "상대와 다른 의견을 편하게 말할 수 있는지"
 },
 {
  "t": 694.562,
  "d": 2.434,
  "text": "이런 게 훨씬 먼저 드러납니다"
 },
 {
  "t": 697.496,
  "d": 6.691,
  "text": "다음 소개팅에서는 첫마디를 뭘 해야 할지부터 고민하지 않았으면 좋겠습니다"
 },
 {
  "t": 704.687,
  "d": 2.501,
  "text": "대신 이 질문을 한번 해보세요"
 },
 {
  "t": 707.188,
  "d": 6.735,
  "text": "나는 지금 이 사람을 알아가고 있는 걸까 아니면 이 사람에게 평가받고 있는 걸까"
 },
 {
  "t": 714.423,
  "d": 6.425,
  "text": "만약 계속 평가받고 있다는 느낌이 든다면 여러분의 행동도 같이 확인해보세요"
 },
 {
  "t": 720.848,
  "d": 3.611,
  "text": "상대에게 너무 많이 맞춰주고 있지는 않은지"
 },
 {
  "t": 724.46,
  "d": 2.814,
  "text": "자꾸 말을 수습하고 있지는 않은지"
 },
 {
  "t": 727.274,
  "d": 2.814,
  "text": "나의 의견을 숨기고 있지는 않은지"
 },
 {
  "t": 730.588,
  "d": 4.306,
  "text": "첫인상은 완벽한 모습을 보여주는 시간이 아닙니다"
 },
 {
  "t": 734.894,
  "d": 4.306,
  "text": "서로 어떤 사람인지 알아보기 시작하는 시간입니다"
 },
 {
  "t": 739.699,
  "d": 6.691,
  "text": "그래서 저는 첫 1분에 모든 게 결정된다는 말을 이렇게 이해했으면 좋겠습니다"
 },
 {
  "t": 746.89,
  "d": 4.978,
  "text": "그 1분 안에 여러분의 모든 조건이 평가된다는 뜻이 아닙니다"
 },
 {
  "t": 751.868,
  "d": 4.227,
  "text": "마음에 드는 사람 앞에서 여러분이 어떤 태도를 취하는지는 생각보다 아주 빠르게 드러난다는"
 },
 {
  "t": 756.095,
  "d": 4.227,
  "text": "뜻입니다"
 },
 {
  "t": 760.822,
  "d": 1.822,
  "text": "그리고 그 태도가 늘"
 },
 {
  "t": 762.644,
  "d": 0.416,
  "text": "눈치"
 },
 {
  "t": 763.06,
  "d": 0.885,
  "text": "과한 배려"
 },
 {
  "t": 763.945,
  "d": 0.885,
  "text": "과한 해명"
 },
 {
  "t": 764.829,
  "d": 0.625,
  "text": "조급함"
 },
 {
  "t": 765.454,
  "d": 1.301,
  "text": "흔들리는 기준"
 },
 {
  "t": 767.255,
  "d": 6.959,
  "text": "이런 식으로 반복된다면 아무리 좋은 말을 준비해도 결국 같은 문제가 반복됩니다"
 },
 {
  "t": 774.714,
  "d": 5.526,
  "text": "소개팅 분위기는 나쁘지 않은데 항상 다음 관계로 이어지지 않거나"
 },
 {
  "t": 780.24,
  "d": 3.335,
  "text": "좋은 사람인데 남자로는 잘 모르겠어요."
 },
 {
  "t": 783.575,
  "d": 2.429,
  "text": "라는 말을 반복해서 듣는다면"
 },
 {
  "t": 786.504,
  "d": 5.799,
  "text": "설명란에 달아둔 무료 비밀 특강에서 그 이유를 먼저 확인해보세요"
 },
 {
  "t": 792.803,
  "d": 4.617,
  "text": "연애에서 바꿔야 할 건 매번 새로운 첫마디가 아닙니다"
 },
 {
  "t": 797.42,
  "d": 3.548,
  "text": "첫마디를 하고 있는 그 사람의 태도입니다"
 }
]