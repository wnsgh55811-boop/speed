 ],
 "chunks": [
  {
   "slide": 1,
   "para": 0,
   "text": "안녕하세요 이다사 메릭입니다",
   "t0": 0.060047166466673935,
   "t1": 1.5211948838224065,
   "s": 0.03333333333333333,
   "e": 1.7333333333333334
  },
  {
   "slide": 1,
   "para": 0,
   "text": "VOD 코스를 시작하신 걸 환영합니다",
   "t0": 1.7613835496891022,
   "t1": 3.6428614323115522,
   "s": 1.7333333333333334,
   "e": 3.9
  },
  {
   "slide": 1,
   "para": 1,
   "text": "본 강의에 들어가기 전에",
   "t0": 3.903065820333806,
   "t1": 5.083993427511727,
   "s": 3.9,
   "e": 5.2
  },
  {
   "slide": 1,
   "para": 1,
   "text": "VOD를 어떻게 수강하시면 되는지",
   "t0": 5.204087760445074,
   "t1": 6.945455587978619,
   "s": 5.2,
   "e": 7.033333333333333
  },
  {
   "slide": 1,
   "para": 1,
   "text": "짧게 정리하겠습니다",
   "t0": 7.045534198756409,
   "t1": 8.146398917312098,
   "s": 7.033333333333333,
   "e": 8.233333333333333
  },
  {
   "slide": 2,
   "para": 0,
   "text": "이 과정에서는 멘트를 외우지 않습니다",
   "t0": 8.786902026289953,
   "t1": 10.568301298134614,
   "s": 8.766666666666667,
   "e": 10.733333333333333
  },
  {
   "slide": 2,
   "para": 0,
   "text": "모르는 사람에게 무작정 다가가는 연습도",
   "t0": 10.748442797534635,
   "t1": 12.790046457401548,
   "s": 10.733333333333333,
   "e": 12.8
  },
  {
   "slide": 2,
   "para": 0,
   "text": "하지 않습니다",
   "t0": 12.810062179557107,
   "t1": 13.410533844223846,
   "s": 12.8,
   "e": 13.666666666666666
  },
  {
   "slide": 2,
   "para": 1,
   "text": "멘트는 상황이 조금만 달라져도 쓸 수 없습니다",
   "t0": 13.690753954401657,
   "t1": 16.092640613068614,
   "s": 13.666666666666666,
   "e": 16.3
  },
  {
   "slide": 2,
   "para": 1,
   "text": "그리고 대부분은 말이 아니라 태도에서 막힙니다",
   "t0": 16.31281355677975,
   "t1": 18.734715937602267,
   "s": 16.3,
   "e": 19.133333333333333
  },
  {
   "slide": 2,
   "para": 1,
   "text": "긴장하면 말이 빨라지고 눈을 피하고",
   "t0": 19.155046102868987,
   "t1": 21.076555429802553,
   "s": 19.133333333333333,
   "e": 21.233333333333334
  },
  {
   "slide": 2,
   "para": 1,
   "text": "상대 반응 하나에 하던 말을 거둬들이죠",
   "t0": 21.236681207047017,
   "t1": 23.018080478891676,
   "s": 21.233333333333334,
   "e": 23.266666666666666
  },
  {
   "slide": 2,
   "para": 2,
   "text": "그래서 이 과정은 상대가 어떤 반응을 해도",
   "t0": 23.27828486691393,
   "t1": 25.339904248936403,
   "s": 23.266666666666666,
   "e": 25.5
  },
  {
   "slide": 2,
   "para": 2,
   "text": "무너지지 않는 태도를 먼저 만드는 과정입니다",
   "t0": 25.500030026180866,
   "t1": 27.801838074070034,
   "s": 25.5,
   "e": 27.9
  },
  {
   "slide": 3,
   "para": 0,
   "text": "12주 뒤에 어떻게 바뀌는지",
   "t0": 28.402309738736772,
   "t1": 29.90348890040362,
   "s": 28.4,
   "e": 30.133333333333333
  },
  {
   "slide": 3,
   "para": 0,
   "text": "그리고 그걸 무엇으로 만드는지",
   "t0": 30.143677566270316,
   "t1": 31.564793839314934,
   "s": 30.133333333333333,
   "e": 31.566666666666666
  },
  {
   "slide": 3,
   "para": 0,
   "text": "말씀드리겠습니다",
   "t0": 31.584809561470493,
   "t1": 32.425469892003925,
   "s": 31.566666666666666,
   "e": 32.63333333333333
  },
  {
   "slide": 3,
   "para": 0,
   "text": "이다사에서는 이걸",
   "t0": 32.66565855787062,
   "t1": 33.54635033271517,
   "s": 32.63333333333333,
   "e": 33.6
  },
  {
   "slide": 3,
   "para": 0,
   "text": "'사자의 태도' 12가지라고 부릅니다",
   "t0": 33.606397499181845,
   "t1": 35.36778104887095,
   "s": 33.6,
   "e": 35.56666666666667
  },
  {
   "slide": 3,
   "para": 0,
   "text": "크게 세 묶음입니다",
   "t0": 35.58795399258209,
   "t1": 36.588740100359985,
   "s": 35.56666666666667,
   "e": 36.86666666666667
  },
  {
   "slide": 3,
   "para": 1,
   "text": "첫 번째는 흔들리지 않는 태도입니다",
   "t0": 36.8689602105378,
   "t1": 38.67037520453802,
   "s": 36.86666666666667,
   "e": 39.1
  },
  {
   "slide": 3,
   "para": 1,
   "text": "상대 반응에 내 가치가 흔들리지 않으면",
   "t0": 39.13073681411585,
   "t1": 41.11229330751609,
   "s": 39.1,
   "e": 41.233333333333334
  },
  {
   "slide": 3,
   "para": 1,
   "text": "\"아무거나요\" 대신 \"저는 이거요\"라고",
   "t0": 41.252403362604994,
   "t1": 43.273991300316354,
   "s": 41.233333333333334,
   "e": 43.3
  },
  {
   "slide": 3,
   "para": 1,
   "text": "말하게 됩니다",
   "t0": 43.314022744627465,
   "t1": 43.89447868713865,
   "s": 43.3,
   "e": 44.13333333333333
  },
  {
   "slide": 3,
   "para": 1,
   "text": "분리 공백 중심 경계선이 여기에 들어갑니다",
   "t0": 44.13466735300535,
   "t1": 46.896837010472346,
   "s": 44.13333333333333,
   "e": 47.1
  },
  {
   "slide": 3,
   "para": 2,
   "text": "두 번째는 끌려다니지 않는 태도입니다",
   "t0": 47.11700995418348,
   "t1": 48.998487836805936,
   "s": 47.1,
   "e": 49.46666666666667
  },
  {
   "slide": 3,
   "para": 2,
   "text": "맞춰주기만 하지 않고 관계를 같이 만들면",
   "t0": 49.47886516853932,
   "t1": 51.70061032780626,
   "s": 49.46666666666667,
   "e": 51.833333333333336
  },
  {
   "slide": 3,
   "para": 2,
   "text": "상대 연락만 기다리는 대신",
   "t0": 51.840720382895164,
   "t1": 53.241820933784226,
   "s": 51.833333333333336,
   "e": 53.333333333333336
  },
  {
   "slide": 3,
   "para": 2,
   "text": "먼저 다음 만남을 제안하게 됩니다",
   "t0": 53.34189954456202,
   "t1": 55.06325164994,
   "s": 53.333333333333336,
   "e": 55.333333333333336
  },
  {
   "slide": 3,
   "para": 2,
   "text": "투자 선택 설계 빈틈 변주가 여기에 들어갑니다",
   "t0": 55.343471760117815,
   "t1": 58.325814361295954,
   "s": 55.333333333333336,
   "e": 58.56666666666667
  },
  {
   "slide": 3,
   "para": 3,
   "text": "세 번째는 끌어당기는 태도입니다",
   "t0": 58.58601874931821,
   "t1": 60.28735513254063,
   "s": 58.56666666666667,
   "e": 60.766666666666666
  },
  {
   "slide": 3,
   "para": 3,
   "text": "상대와 호흡을 맞추고",
   "t0": 60.767732464274026,
   "t1": 61.88861290498527,
   "s": 60.766666666666666,
   "e": 61.96666666666667
  },
  {
   "slide": 3,
   "para": 3,
   "text": "나를 보여주는 대화를 만들어 갑니다",
   "t0": 61.988691515763065,
   "t1": 63.750075065452165,
   "s": 61.96666666666667,
   "e": 64.03333333333333
  },
  {
   "slide": 3,
   "para": 3,
   "text": "질문만 하다 끊기던 대화가",
   "t0": 64.05031089778554,
   "t1": 65.43139572651903,
   "s": 64.03333333333333,
   "e": 65.56666666666666
  },
  {
   "slide": 3,
   "para": 3,
   "text": "내 이야기로 이어지게 됩니다",
   "t0": 65.57150578160794,
   "t1": 66.89254344387477,
   "s": 65.56666666666666,
   "e": 67.16666666666667
  },
  {
   "slide": 3,
   "para": 3,
   "text": "주파수 서사 온도 청사진이 여기에 들어갑니다",
   "t0": 67.17276355405258,
   "t1": 69.95494893367514,
   "s": 67.16666666666667,
   "e": 70.23333333333333
  },
  {
   "slide": 3,
   "para": 4,
   "text": "지금 이름을 다 외울 필요는 없습니다",
   "t0": 70.23516904385295,
   "t1": 71.99655259354205,
   "s": 70.23333333333333,
   "e": 72.46666666666667
  },
  {
   "slide": 3,
   "para": 4,
   "text": "강의에서 하나씩 다룰 겁니다",
   "t0": 72.496945647431,
   "t1": 73.77795186538671,
   "s": 72.46666666666667,
   "e": 74.0
  },
  {
   "slide": 3,
   "para": 4,
   "text": "흔들리지 않는다 끌려다니지 않는다 끌어당긴다",
   "t0": 74.01814053125341,
   "t1": 76.72026302225373,
   "s": 74.0,
   "e": 77.06666666666666
  },
  {
   "slide": 3,
   "para": 4,
   "text": "이 세 가지만 기억하시면 됩니다",
   "t0": 77.08054602105378,
   "t1": 78.5016622940984,
   "s": 77.06666666666666,
   "e": 78.6
  },
  {
   "slide": 4,
   "para": 0,
   "text": "이 태도들은 말만 바꿔서는 체화되지 않습니다",
   "t0": 78.96202390367623,
   "t1": 81.46398917312098,
   "s": 78.93333333333334,
   "e": 81.63333333333334
  },
  {
   "slide": 4,
   "para": 0,
   "text": "시선 자세 말투 등 모든 것이",
   "t0": 81.66414639467655,
   "t1": 83.62568716592124,
   "s": 81.63333333333334,
   "e": 83.63333333333334
  },
  {
   "slide": 4,
   "para": 0,
   "text": "같이 바뀌어야 합니다",
   "t0": 83.6457028880768,
   "t1": 84.52639466292135,
   "s": 83.63333333333334,
   "e": 84.8
  },
  {
   "slide": 4,
   "para": 0,
   "text": "진단 때 직접 확인하셨겠지만",
   "t0": 84.82663049525472,
   "t1": 86.4078725455438,
   "s": 84.8,
   "e": 86.5
  },
  {
   "slide": 4,
   "para": 0,
   "text": "이건 본인 눈에 잘 안 보입니다",
   "t0": 86.52796687847714,
   "t1": 87.96909887367732,
   "s": 86.5,
   "e": 88.2
  },
  {
   "slide": 4,
   "para": 1,
   "text": "VOD 코스는",
   "t0": 88.20928753954402,
   "t1": 89.00991642576633,
   "s": 88.2,
   "e": 89.1
  },
  {
   "slide": 4,
   "para": 1,
   "text": "혼자서 끝까지 할 수 있게 만든 코스입니다",
   "t0": 89.10999503654412,
   "t1": 91.0315043634777,
   "s": 89.1,
   "e": 91.46666666666667
  },
  {
   "slide": 4,
   "para": 1,
   "text": "강의를 보고 영상 속 연습을 따라 하고",
   "t0": 91.49186597305552,
   "t1": 93.41337529998908,
   "s": 91.46666666666667,
   "e": 93.56666666666666
  },
  {
   "slide": 4,
   "para": 1,
   "text": "워크북으로 과제를 하면서",
   "t0": 93.5935167993891,
   "t1": 94.81447585087815,
   "s": 93.56666666666666,
   "e": 94.9
  },
  {
   "slide": 4,
   "para": 1,
   "text": "끝까지 갈 수 있습니다",
   "t0": 94.91455446165594,
   "t1": 95.87530912512273,
   "s": 94.9,
   "e": 96.1
  },
  {
   "slide": 4,
   "para": 2,
   "text": "혼자 해보다가",
   "t0": 96.11549779098942,
   "t1": 96.8360637885895,
   "s": 96.1,
   "e": 96.93333333333334
  },
  {
   "slide": 4,
   "para": 2,
   "text": "하나하나 구체적인 피드백과 교정이",
   "t0": 96.95615812152285,
   "t1": 98.8376360041453,
   "s": 96.93333333333334,
   "e": 98.86666666666666
  },
  {
   "slide": 4,
   "para": 2,
   "text": "필요하다고 느끼시면",
   "t0": 98.89768317061197,
   "t1": 99.87845355623432,
   "s": 98.86666666666666,
   "e": 100.16666666666667
  },
  {
   "slide": 4,
   "para": 2,
   "text": "그때 이다사 부트캠프로 바꾸셔도 됩니다",
   "t0": 100.17868938856769,
   "t1": 102.42045026999018,
   "s": 100.16666666666667,
   "e": 102.86666666666666
  },
  {
   "slide": 4,
   "para": 2,
   "text": "12주 동안 저와 1:1로",
   "t0": 102.88081187956801,
   "t1": 104.38199104123487,
   "s": 102.86666666666666,
   "e": 104.5
  },
  {
   "slide": 4,
   "para": 2,
   "text": "실제 상황을 연습하고",
   "t0": 104.52210109632377,
   "t1": 105.66299725919058,
   "s": 104.5,
   "e": 105.8
  },
  {
   "slide": 4,
   "para": 2,
   "text": "그 자리에서 교정받는 집중 코칭이고",
   "t0": 105.82312303643504,
   "t1": 107.68458519690193,
   "s": 105.8,
   "e": 108.1
  },
  {
   "slide": 4,
   "para": 2,
   "text": "이후에는 평생 멤버십으로 이어집니다",
   "t0": 108.10491536216864,
   "t1": 109.9863932447911,
   "s": 108.1,
   "e": 110.16666666666667
  },
  {
   "slide": 4,
   "para": 3,
   "text": "부트캠프로 바꾸시면",
   "t0": 110.18655046634667,
   "t1": 111.26739946274681,
   "s": 110.16666666666667,
   "e": 111.36666666666666
  },
  {
   "slide": 4,
   "para": 3,
   "text": "VOD 결제 금액은 빼고 시작합니다",
   "t0": 111.3674780735246,
   "t1": 113.2289402339915,
   "s": 111.36666666666666,
   "e": 113.33333333333333
  },
  {
   "slide": 5,
   "para": 0,
   "text": "12주는 2주씩 6단계로 진행합니다",
   "t0": 113.70931756572489,
   "t1": 115.81096839205847,
   "s": 113.7,
   "e": 116.06666666666666
  },
  {
   "slide": 5,
   "para": 1,
   "text": "1단계에서 나를 먼저 세우고",
   "t0": 116.09118850223628,
   "t1": 117.57235194174757,
   "s": 116.06666666666666,
   "e": 117.96666666666667
  },
  {
   "slide": 5,
   "para": 1,
   "text": "2단계부터 4단계까지",
   "t0": 117.97266638485873,
   "t1": 119.19362543634777,
   "s": 117.96666666666667,
   "e": 119.33333333333333
  },
  {
   "slide": 5,
   "para": 1,
   "text": "사자의 태도를 한 묶음씩 익힙니다",
   "t0": 119.35375121359223,
   "t1": 120.97502470819242,
   "s": 119.33333333333333,
   "e": 121.43333333333334
  },
  {
   "slide": 5,
   "para": 1,
   "text": "5단계에서 그걸 소개팅과 호감 표현에 적용하고",
   "t0": 121.45540203992581,
   "t1": 123.97738303152613,
   "s": 121.43333333333334,
   "e": 124.36666666666666
  },
  {
   "slide": 5,
   "para": 1,
   "text": "6단계에서는 연애를 시작한 뒤에도",
   "t0": 124.39771319679284,
   "t1": 126.2791910794153,
   "s": 124.36666666666666,
   "e": 126.36666666666666
  },
  {
   "slide": 5,
   "para": 1,
   "text": "나를 잃지 않는 법을 다룹니다",
   "t0": 126.39928541234865,
   "t1": 127.88044885185992,
   "s": 126.36666666666666,
   "e": 127.96666666666667
  },
  {
   "slide": 6,
   "para": 0,
   "text": "혼자 하는 코스라서",
   "t0": 128.44088907221555,
   "t1": 129.40164373568234,
   "s": 128.43333333333334,
   "e": 129.53333333333333
  },
  {
   "slide": 6,
   "para": 0,
   "text": "지켜야 할 것 세 가지만 말씀드리겠습니다",
   "t0": 129.54175379077125,
   "t1": 131.40321595123814,
   "s": 129.53333333333333,
   "e": 131.7
  },
  {
   "slide": 6,
   "para": 1,
   "text": "첫째 순서대로 보세요",
   "t0": 131.72346750572706,
   "t1": 133.00447372368276,
   "s": 131.7,
   "e": 133.36666666666667
  },
  {
   "slide": 6,
   "para": 1,
   "text": "앞 단계를 건너뛰면",
   "t0": 133.38477244463837,
   "t1": 134.40557427457182,
   "s": 133.36666666666667,
   "e": 134.43333333333334
  },
  {
   "slide": 6,
   "para": 1,
   "text": "실전에서 긴장하는 순간",
   "t0": 134.4656214410385,
   "t1": 135.7065962146831,
   "s": 134.43333333333334,
   "e": 135.7
  },
  {
   "slide": 6,
   "para": 1,
   "text": "배운 게 나오지 않습니다",
   "t0": 135.72661193683865,
   "t1": 136.72739804461656,
   "s": 135.7,
   "e": 136.93333333333334
  },
  {
   "slide": 6,
   "para": 2,
   "text": "둘째 과제는 전부 하세요",
   "t0": 136.9475709883277,
   "t1": 138.48878159430566,
   "s": 136.93333333333334,
   "e": 138.86666666666667
  },
  {
   "slide": 6,
   "para": 2,
   "text": "단계마다 중요한 과제들을 지정해 두었습니다",
   "t0": 138.8890960374168,
   "t1": 141.0908254745282,
   "s": 138.86666666666667,
   "e": 141.3
  },
  {
   "slide": 6,
   "para": 2,
   "text": "과제를 건너뛰면 강의는 지식으로만 남고",
   "t0": 141.3310141403949,
   "t1": 143.5727750218174,
   "s": 141.3,
   "e": 143.66666666666666
  },
  {
   "slide": 6,
   "para": 2,
   "text": "행동은 바뀌지 않습니다",
   "t0": 143.69286935475074,
   "t1": 144.8537812397731,
   "s": 143.66666666666666,
   "e": 145.13333333333333
  },
  {
   "slide": 6,
   "para": 3,
   "text": "셋째 영상에서 제가 멈추라고 하면",
   "t0": 145.15401707210646,
   "t1": 147.29569934275116,
   "s": 145.13333333333333,
   "e": 147.43333333333334
  },
  {
   "slide": 6,
   "para": 3,
   "text": "실제로 멈추세요",
   "t0": 147.45582511999564,
   "t1": 148.39656406130686,
   "s": 147.43333333333334,
   "e": 148.86666666666667
  },
  {
   "slide": 6,
   "para": 3,
   "text": "강의 중간중간",
   "t0": 148.87694139304025,
   "t1": 149.7176017235737,
   "s": 148.86666666666667,
   "e": 149.76666666666668
  },
  {
   "slide": 6,
   "para": 3,
   "text": "직접 써 보고 말해 보는 연습이 들어 있습니다",
   "t0": 149.79766461219592,
   "t1": 151.83926827206284,
   "s": 149.76666666666668,
   "e": 152.06666666666666
  },
  {
   "slide": 6,
   "para": 3,
   "text": "눈으로만 보면 다 아는 것 같지만",
   "t0": 152.0994726600851,
   "t1": 153.64068326606304,
   "s": 152.06666666666666,
   "e": 153.76666666666668
  },
  {
   "slide": 6,
   "para": 3,
   "text": "막상 입으로 해보면 전혀 다르게 나옵니다",
   "t0": 153.78079332115195,
   "t1": 155.9024598696411,
   "s": 153.76666666666668,
   "e": 156.23333333333332
  },
  {
   "slide": 6,
   "para": 3,
   "text": "그 차이를 영상 안에서 먼저 겪어야",
   "t0": 156.24272714628557,
   "t1": 157.96407925166358,
   "s": 156.23333333333332,
   "e": 158.1
  },
  {
   "slide": 6,
   "para": 3,
   "text": "실전에서 막히지 않습니다",
   "t0": 158.1041893067525,
   "t1": 159.3851955247082,
   "s": 158.1,
   "e": 159.5
  },
  {
   "slide": 7,
   "para": 0,
   "text": "이 영상이 끝나면 두 가지를 하시면 됩니다",
   "t0": 159.88558857859715,
   "t1": 161.82711362768626,
   "s": 159.86666666666667,
   "e": 162.16666666666666
  },
  {
   "slide": 7,
   "para": 0,
   "text": "2분짜리 자기소개 영상을 찍고",
   "t0": 162.1873966264863,
   "t1": 163.72860723246427,
   "s": 162.16666666666666,
   "e": 163.9
  },
  {
   "slide": 7,
   "para": 0,
   "text": "12주 목표를 적습니다",
   "t0": 163.9087487318643,
   "t1": 165.08967633904223,
   "s": 163.9,
   "e": 165.36666666666667
  },
  {
   "slide": 7,
   "para": 0,
   "text": "목표는 진단 때 짚어드린 부분부터",
   "t0": 165.36989644922002,
   "t1": 167.27139005399803,
   "s": 165.36666666666667,
   "e": 167.3
  },
  {
   "slide": 7,
   "para": 0,
   "text": "적으시면 됩니다",
   "t0": 167.33143722046472,
   "t1": 168.03198749590925,
   "s": 167.3,
   "e": 168.26666666666668
  },
  {
   "slide": 7,
   "para": 1,
   "text": "자기소개 영상은 잘 찍을 필요 없습니다",
   "t0": 168.29219188393148,
   "t1": 170.17366976655393,
   "s": 168.26666666666668,
   "e": 170.6
  },
  {
   "slide": 7,
   "para": 1,
   "text": "지금 모습이 기준점이고",
   "t0": 170.61401565397622,
   "t1": 171.83497470546524,
   "s": 170.6,
   "e": 171.93333333333334
  },
  {
   "slide": 7,
   "para": 1,
   "text": "6주차와 12주차에 다시 찍어 비교합니다",
   "t0": 171.9550690383986,
   "t1": 174.17681419766555,
   "s": 171.93333333333334,
   "e": 174.36666666666667
  },
  {
   "slide": 7,
   "para": 1,
   "text": "그러니 지우지 마세요",
   "t0": 174.39698714137668,
   "t1": 175.41778897131013,
   "s": 174.36666666666667,
   "e": 175.63333333333333
  },
  {
   "slide": 7,
   "para": 2,
   "text": "처음엔 어색하고 보기 싫을 겁니다",
   "t0": 175.65797763717683,
   "t1": 177.35931402039927,
   "s": 175.63333333333333,
   "e": 177.6
  },
  {
   "slide": 7,
   "para": 2,
   "text": "그 어색함이 12주 뒤에 얼마나 줄었는지",
   "t0": 177.6195184084215,
   "t1": 179.90131073415512,
   "s": 177.6,
   "e": 180.03333333333333
  },
  {
   "slide": 7,
   "para": 2,
   "text": "직접 확인하시게 될 겁니다",
   "t0": 180.0614365113996,
   "t1": 181.36245845151086,
   "s": 180.03333333333333,
   "e": 181.8
  },
  {
   "slide": 7,
   "para": 3,
   "text": "그럼 1강에서 뵙겠습니다",
   "t0": 181.80280433893313,
